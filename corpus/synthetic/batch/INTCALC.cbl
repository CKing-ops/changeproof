000001 IDENTIFICATION DIVISION.
000002 PROGRAM-ID. INTCALC.
000003* Synthetic batch subprogram: interest on a deposit by rate code and term.
000004 DATA DIVISION.
000005 WORKING-STORAGE SECTION.
000006 01  WS-RATE                 PIC 9V9(4).
000007 01  WS-DAYS                 PIC 9(4).
000008 LINKAGE SECTION.
000009 01  LK-PRINCIPAL            PIC S9(9)V99.
000010 01  LK-RATE-CODE            PIC XX.
000011 01  LK-DAYS                 PIC 9(4).
000012 01  LK-INTEREST             PIC S9(9)V99.
000013 01  LK-STATUS               PIC XX.
000014 PROCEDURE DIVISION USING LK-PRINCIPAL LK-RATE-CODE LK-DAYS
000015                          LK-INTEREST LK-STATUS.
000016 MAIN-PARA.
000017     MOVE 0 TO LK-INTEREST
000018     MOVE 'OK' TO LK-STATUS
000019     EVALUATE LK-RATE-CODE
000020         WHEN 'ST'
000021             MOVE 0.0350 TO WS-RATE
000022         WHEN 'PR'
000023             MOVE 0.0425 TO WS-RATE
000024         WHEN 'VP'
000025             MOVE 0.0500 TO WS-RATE
000026         WHEN OTHER
000027             MOVE 'E1' TO LK-STATUS
000028             GOBACK
000029     END-EVALUATE
000030     IF LK-DAYS = 0
000031         MOVE 'E2' TO LK-STATUS
000032         GOBACK
000033     END-IF
000034     IF LK-DAYS > 365
000035         MOVE 365 TO WS-DAYS
000036     ELSE
000037         MOVE LK-DAYS TO WS-DAYS
000038     END-IF
000039     COMPUTE LK-INTEREST ROUNDED =
000040         LK-PRINCIPAL * WS-RATE * WS-DAYS / 365
000041     IF LK-PRINCIPAL >= 100000
000042         COMPUTE LK-INTEREST ROUNDED = LK-INTEREST * 1.10
000043     END-IF
000044     IF LK-INTEREST > 5000
000045         MOVE 5000 TO LK-INTEREST
000046         MOVE 'CP' TO LK-STATUS
000047     END-IF
000048     GOBACK.
