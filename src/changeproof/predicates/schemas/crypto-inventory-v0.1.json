{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:changeproof:predicate:crypto-inventory:v0.1",
  "title": "changeproof crypto-inventory predicate v0.1 (draft)",
  "description": "Cryptographic uses found in code and config, each located to file:line.",
  "type": "object",
  "required": ["scope", "findings", "engine"],
  "additionalProperties": false,
  "properties": {
    "scope": {
      "type": "object",
      "required": ["revision"],
      "properties": {"revision": {"type": "string"}, "components": {"type": "array", "items": {"type": "string"}}}
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "primitive", "algorithm", "quantum_vulnerable", "evidence", "provenance"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "primitive": {"enum": ["signature", "kem", "key-exchange", "cipher", "hash", "mac", "rng", "certificate", "unknown"]},
          "algorithm": {"type": "string", "description": "Identifier as detected, e.g. rsa-2048; 'unknown' when not determinable."},
          "parameters": {"type": "object"},
          "quantum_vulnerable": {"type": ["boolean", "null"], "description": "null when the algorithm could not be determined."},
          "migration_category": {"type": ["string", "null"], "description": "Category under the active crypto profile, e.g. eu-pqc-roadmap high-risk."},
          "migration_deadline": {"type": ["string", "null"], "format": "date"},
          "evidence": {"type": "string", "description": "The call, API or config key that revealed the use."},
          "provenance": {"$ref": "urn:changeproof:schema:common:v0.1#/$defs/provenance"}
        }
      }
    },
    "cbom": {"description": "Digest of the CycloneDX CBOM emitted alongside.", "$ref": "urn:changeproof:schema:common:v0.1#/$defs/digest"},
    "engine": {"$ref": "urn:changeproof:schema:common:v0.1#/$defs/engine"}
  }
}
