000001 IDENTIFICATION DIVISION.
000002 PROGRAM-ID. INVONL.
000003 DATA DIVISION.
000004 WORKING-STORAGE SECTION.
000005     COPY CUSTREC.
000006 01  WS-PGM                  PIC X(8).
000007 01  WS-AMOUNT               PIC S9(9)V99.
000008 PROCEDURE DIVISION.
000009 MAIN-PARA.
000010     EXEC CICS READ FILE('CUSTFIL') INTO(CUST-REC)
000011          RIDFLD(CUST-ID) END-EXEC
000012     MOVE 'TAXCALC' TO WS-PGM
000013     EXEC CICS LINK PROGRAM(WS-PGM) COMMAREA(WS-AMOUNT) END-EXEC
000014     EXEC CICS RETURN TRANSID('INV1') END-EXEC
000015     GOBACK.
