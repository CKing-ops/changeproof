000001 IDENTIFICATION DIVISION.
000002 PROGRAM-ID. INVMAIN.
000003*SYNTHETIC INVOICE RUN FOR THE WEEK 5 IMPACT TESTS
000004 ENVIRONMENT DIVISION.
000005 INPUT-OUTPUT SECTION.
000006 FILE-CONTROL.
000007     SELECT CUST-IN ASSIGN TO CUSTIN.
000008     SELECT INV-OUT ASSIGN TO INVOUT.
000009 DATA DIVISION.
000010 FILE SECTION.
000011 FD  CUST-IN.
000012 01  CUST-IN-REC             PIC X(80).
000013 FD  INV-OUT.
000014 01  INV-REC                 PIC X(80).
000015 WORKING-STORAGE SECTION.
000016     COPY CUSTREC.
000017 01  WS-AMOUNT               PIC S9(9)V99.
000018 01  WS-TAX                  PIC S9(9)V99.
000019 01  WS-TOTAL                PIC S9(9)V99.
000020 01  WS-LINE                 PIC X(80).
000021 PROCEDURE DIVISION.
000022 MAIN-PARA.
000023     OPEN INPUT CUST-IN OUTPUT INV-OUT
000024     READ CUST-IN INTO CUST-REC
000025     PERFORM PRICE-PARA
000026     PERFORM SIGN-PARA
000027     PERFORM POST-PARA
000028     CLOSE CUST-IN INV-OUT
000029     STOP RUN.
000030 PRICE-PARA.
000031     CALL 'TAXCALC' USING WS-AMOUNT WS-TAX
000032     COMPUTE WS-TOTAL = WS-AMOUNT + WS-TAX.
000033 SIGN-PARA.
000034     CALL 'INVSIGN' USING WS-LINE.
000035 POST-PARA.
000036     MOVE WS-TOTAL TO WS-LINE
000037     WRITE INV-REC FROM WS-LINE
000038     EXEC SQL
000039         UPDATE INVOICES SET TOTAL = :WS-TOTAL
000040     END-EXEC.
