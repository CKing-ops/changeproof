//INDIRECT JOB 'RUN',CLASS=A
//* SYNTHETIC: PROGRAMS RUN THROUGH TSO BATCH AND AN IMS REGION
//DB2STEP  EXEC PGM=IKJEFT01,REGION=0M
//SYSTSPRT DD SYSOUT=*
//SYSTSIN  DD *
  DSN SYSTEM(DB01)
  RUN PROGRAM(BATCH1) PLAN(PAYPLAN)
  END
